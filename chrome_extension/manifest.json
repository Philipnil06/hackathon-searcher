{
  "manifest_version": 3,
  "name": "Hackathon Searcher Autofill",
  "version": "1.5.1",
  "description": "Locally autofills prepared Luma applications; submits only when auto-submit is enabled.",
  "permissions": ["storage"],
  "host_permissions": ["https://luma.com/*", "https://*.luma.com/*", "https://lu.ma/*", "https://*.lu.ma/*", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://luma.com/*", "https://*.luma.com/*", "https://lu.ma/*", "https://*.lu.ma/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "Hackathon Searcher", "default_popup": "popup.html"}
}
