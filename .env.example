# Copy to .env. Never commit .env.
# Safety defaults
DRY_RUN=true
LIVE_TEST_MODE=false
AUTO_APPLY=false
TEAM_MIN_APPLY_SCORE=55
# Setup creates this automatically. This fallback is only for advanced manual setup.
TEAM_APPLICANT_IDS=builder
TEAM_CONFIG_PATH=team.json
MAX_LIVE_APPLICATIONS_PER_RUN=3
LIVE_MIN_EVENT_SCORE=60
LIVE_MIN_APPLY_SCORE=60
LIVE_REQUIRE_CONFIRMED_TRAVEL=false

# Chrome extension auto-submit (Luma). The extension clicks the final submit
# only when DRY_RUN=false AND LUMA_AUTO_SUBMIT=true. Never set true in dry-run.
LUMA_AUTO_SUBMIT=false
LUMA_CONFIRMATION_TIMEOUT_MS=9000

# Local paths (all relative to the repository root)
PROFILES_DIR=profiles
ANSWER_LIBRARY_DIR=answer_library
DATABASE_PATH=hackathon_searcher.db
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
HACKATHON_HUB_URL=https://hackathonhub.eu/
# Limits for the daily background task. Increase only for deliberate manual runs.
DAILY_STAGE2_CAP=5
DAILY_MAX_RUNTIME_MINUTES=25

# LLM provider configuration. Choose one locally; leave unused keys blank.
# Supported LLM_PROVIDER values: openai, anthropic, gemini, mistral, openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Required only for openai_compatible, e.g. https://api.example.com/v1
LLM_BASE_URL=
# Optional pricing overrides, USD per 1M input/output tokens. Leave blank to
# use built-in rates for known models; unknown/custom models remain unpriced.
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
