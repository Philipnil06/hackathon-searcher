# Hackathon Searcher Configuration
# Copy this to .env and customize

# Application behavior
AUTO_APPLY=true
DRY_RUN=true
MIN_APPLICATION_SCORE=55
AUTO_APPLY_FLIGHT_SUPPORT=true

# Discovery
HACKATHON_HUB_URL=https://hackathonhub.eu/
CRAWL_INTERVAL_HOURS=24

# Geography
HOME_CITY=Stockholm
HOME_COUNTRY=Sweden
PREFER_PHYSICAL_EVENTS=true

# Paths
PROFILE_PATH=profile.json
ANSWER_LIBRARY_PATH=answer_library.json
DATABASE_PATH=hackathon_searcher.db

# Browser
HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Notifications
NOTIFY_HIGH_SCORE_THRESHOLD=80
NOTIFY_ON_APPLICATION=true
NOTIFY_ON_FLIGHT_SUPPORT=true
NOTIFY_ON_BLOCKED=true

# Logging
LOG_LEVEL=INFO
